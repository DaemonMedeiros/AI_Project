# ---- Build artifacts (regenerated by `make`) ----
build/
bin/

# ---- Object/dependency files (in case they ever end up outside build/) ----
*.o
*.d
*.obj
*.exe
*.out

# ---- VSCodium / VS Code ----
# Keep settings.json, tasks.json, c_cpp_properties.json (shared project config)
# but ignore user-specific / auto-generated editor files.
.vscode/*.log
.vscode/ipch/
.vscode/browse.vc.db*
*.code-workspace

# ---- OS cruft ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Portable toolchain / library (if ever copied inside the repo by mistake) ----
w64devkit/
raylib-*/

# NOTE: resources/ at the project root is SOURCE data — do not ignore it.
# Only the copy under bin/resources/ (covered by "bin/" above) is generated.
