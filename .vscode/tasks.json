{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (make)",
            "type": "shell",
            "command": "C:/w64devkit/bin/make.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run (make run)",
            "type": "shell",
            "command": "C:/w64devkit/bin/make.exe",
            "args": ["run"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Clean (make clean)",
            "type": "shell",
            "command": "C:/w64devkit/bin/make.exe",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build x64",
            "type": "shell",
            "command": "C:/w64devkit/bin/make.exe",
            "args": ["x64"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build x86",
            "type": "shell",
            "command": "C:/w64devkit/bin/make.exe",
            "args": ["x86"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
