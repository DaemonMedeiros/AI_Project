{
    // ---- IntelliSense (C/C++ extension) ----
    "C_Cpp.default.compilerPath": "C:/w64devkit/bin/g++.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/src/**",
        "C:/raylib-6.0_win64_mingw-w64/include"
    ],

    // ---- Make sure the integrated terminal can find gcc/g++/make/gdb ----
    "terminal.integrated.env.windows": {
        "PATH": "C:\\w64devkit\\bin;${env:PATH}"
    },

    // ---- File associations so .hpp is treated as C++ ----
    "files.associations": {
        "*.hpp": "cpp",
        "*.h": "c"
    },

    // ---- This project uses a plain Makefile, not CMake ----
    "cmake.configureOnOpen": false,

    // ---- Quality of life ----
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.exclude": {
        "**/build": true,
        "**/bin": false
    }
}
